{
  "$schema": "https://mintlify.com/schema.json",
  "name": "DeskBoy",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#2a7449",
    "light": "#57966e",
    "dark": "#1e5334",
    "background": {
      "light": "#f4faf6",
      "dark": "#0a140e"
    }
  },
  "font": {
    "headings": {
      "family": "Literata"
    },
    "body": {
      "family": "Manrope"
    }
  },
  "topbarLinks": [
    {
      "name": "Σύνδεση",
      "url": "https://app.deskboy.app/login"
    }
  ],
  "topbarCtaButton": {
    "name": "Δοκιμάστε δωρεάν",
    "url": "https://app.deskboy.app/register"
  },
  "versions": ["Ελληνικά", "English"],
  "anchors": [
    {
      "name": "Επικοινωνία",
      "icon": "envelope",
      "url": "mailto:support@deskboy.app"
    }
  ],
  "navigation": [
    {
      "version": "Ελληνικά",
      "group": "Ξεκινήστε",
      "pages": ["intro", "getting-started", "guides/onboarding"]
    },
    {
      "version": "Ελληνικά",
      "group": "Οδηγοί Χρήσης",
      "pages": [
        "guides/checkouts",
        "guides/properties",
        "guides/online-check-in",
        "guides/cleaning-staff",
        "guides/invoicing",
        "guides/private-individual",
        "guides/climate-fee",
        "guides/auto-invoicing",
        "guides/declarations",
        "guides/aade-connect",
        "guides/airbnb",
        "guides/hospitable"
      ]
    },
    {
      "version": "Ελληνικά",
      "group": "Διαχείριση",
      "pages": ["guides/team", "guides/billing", "guides/language-format"]
    },
    {
      "version": "Ελληνικά",
      "group": "Εργαλεία",
      "pages": [
        "guides/assistant",
        "guides/chrome-extension",
        "guides/etherly-insights",
        "guides/data-access-api"
      ]
    },
    {
      "version": "Ελληνικά",
      "group": "Βοήθεια",
      "pages": ["faq"]
    },
    {
      "version": "English",
      "group": "Get Started",
      "pages": ["en/intro", "en/getting-started", "en/guides/onboarding"]
    },
    {
      "version": "English",
      "group": "Guides",
      "pages": [
        "en/guides/checkouts",
        "en/guides/properties",
        "en/guides/online-check-in",
        "en/guides/cleaning-staff",
        "en/guides/invoicing",
        "en/guides/private-individual",
        "en/guides/climate-fee",
        "en/guides/auto-invoicing",
        "en/guides/declarations",
        "en/guides/aade-connect",
        "en/guides/airbnb",
        "en/guides/hospitable"
      ]
    },
    {
      "version": "English",
      "group": "Management",
      "pages": ["en/guides/team", "en/guides/billing", "en/guides/language-format"]
    },
    {
      "version": "English",
      "group": "Tools",
      "pages": [
        "en/guides/assistant",
        "en/guides/chrome-extension",
        "en/guides/etherly-insights",
        "en/guides/data-access-api"
      ]
    },
    {
      "version": "English",
      "group": "Help",
      "pages": ["en/faq"]
    }
  ],
  "modeToggle": {
    "default": "light",
    "isHidden": true
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "search": {
    "prompt": "Search... / Αναζήτηση..."
  }
